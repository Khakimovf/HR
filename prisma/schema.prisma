datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Department {
  id               String               @id @default(uuid())
  code             String?
  name             String
  description      String?
  parentId         String?
  staffLimit       Int?
  parent           Department?          @relation("DeptHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children         Department[]         @relation("DeptHierarchy")
  positions        Position[]
  employees        Employee[]           @relation("CurrentDept")
  fromTransfers    DepartmentTransfer[] @relation("FromDept")
  toTransfers      DepartmentTransfer[] @relation("ToDept")
  userAccess       UserDepartmentAccess[]
  homeUsers        User[]               @relation("UserHomeDept")
  kpiTemplates     KpiTemplate[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Position {
  id                  String               @id @default(uuid())
  departmentId        String
  department          Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title               String
  quotaLimit          Int                  @default(1)
  reportsToPositionId String?
  reportsToPosition   Position?            @relation("PositionHierarchy", fields: [reportsToPositionId], references: [id], onDelete: SetNull)
  subordinatePositions Position[]          @relation("PositionHierarchy")
  employees           Employee[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Employee {
  id                  String               @id @default(uuid())
  tabelNumber         String               @unique
  firstName           String
  lastName            String
  middleName          String?
  gender              String               @default("MALE") // MALE, FEMALE
  dateOfBirth         DateTime
  hireDate            DateTime
  status              String               @default("ACTIVE") // ACTIVE, ON_LEAVE, TRANSFERRED, OFFBOARDED
  phone               String?
  email               String?
  address             String?
  pinfl               String?
  passportNumber      String?
  avatarUrl           String?
  militaryCertificate String?

  // Section 2: Employment & Schedule
  currentDepartmentId String
  currentDepartment   Department           @relation("CurrentDept", fields: [currentDepartmentId], references: [id])
  position            String
  positionId          String?
  positionRef         Position?            @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employmentType      String?              @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT
  baseSalary          Float?               @default(4500000)
  orderNumber         String?
  workSchedule        String?

  // Section 3: Education & Qualification Quick Fields
  educationLevel      String?
  institutionName     String?
  fieldOfStudy        String?
  diplomaNumber       String?
  foreignLanguages    String?
  certifications      String?

  // Section 4: Family & Social Status
  maritalStatus       String?
  familyCount         Int?
  emergencyContactName String?
  emergencyContactPhone String?

  // Section 5: Documents & Attached Digital Files
  passportScanUrl     String?
  diplomaScanUrl      String?
  contractPdfUrl      String?
  stirInpsPdfUrl      String?
  
  educations          Education[]
  permits             PermitLicense[]
  transfers           DepartmentTransfer[]
  leaves              LeaveAttendance[]
  leaveRequests       LeaveRequest[]
  disciplinaryActions DisciplinaryAction[]
  rewards             RewardFinancialAid[]
  kpiRecords          KpiRecord[]
  medicalCheckups     MedicalCheckup[]
  safetyBriefings     SafetyBriefing[]
  kpiEvaluations      KpiEvaluation[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([currentDepartmentId])
  @@index([status])
  @@index([hireDate])
}

model Education {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  level           String   // HIGHER, SECONDARY_SPECIAL, SECONDARY, VOCATIONAL
  institutionName String
  fieldOfStudy    String
  graduationYear  Int
}

model PermitLicense {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  licenseType   String    // DRIVING, FORKLIFT_KARA, MOBILE_PHONE_ON_SITE, PROFESSIONAL_CERT
  category      String?   // e.g. "A, B, C, D, E, F"
  certificateNo String
  issueDate     DateTime
  expiryDate    DateTime?
  status        String    @default("ACTIVE") // ACTIVE, EXPIRED

  @@index([employeeId, expiryDate])
}

model DepartmentTransfer {
  id               String     @id @default(uuid())
  employeeId       String
  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fromDepartmentId String
  fromDepartment   Department @relation("FromDept", fields: [fromDepartmentId], references: [id])
  toDepartmentId   String
  toDepartment     Department @relation("ToDept", fields: [toDepartmentId], references: [id])
  transferDate     DateTime   @default(now())
  orderNumber      String
  reason           String?
}

model LeaveAttendance {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Types: MEHNAT_TATILI(MT), BS_UNPAID(B/S), SICK_LEAVE_BL(B/L), OQISH_TATILI,
  //        OTGUL, ADMIN_TATIL, KECHIKISH_RUXSATNOMA, PROGUL, LATE_ARRIVAL
  type        String
  startDate   DateTime
  endDate     DateTime
  totalDays   Int      @default(0)
  totalHours  Float?   // For hourly permits (KECHIKISH_RUXSATNOMA etc.)
  startTime   String?  // "09:00" – for hourly permits
  endTime     String?  // "11:30" – for hourly permits
  hoursLate   Float?   // Legacy field kept for KPI compatibility
  orderNumber String?  // Buyruq / Ariza raqami
  reason      String?
  // Status: ACTIVE (ongoing), COMPLETED, CANCELLED, APPROVED (legacy)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  @@index([employeeId, status, startDate])
}

model DisciplinaryAction {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  orderNumber String
  type        String   // WARNING, REPRIMAND, SEVERE_REPRIMAND, FINANCIAL_PENALTY
  startDate   DateTime
  expiryDate  DateTime
  status      String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
}

model RewardFinancialAid {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        String   // REWARD, FINANCIAL_AID, BONUS
  amount      Float
  reason      String
  orderNumber String
  orderDate   DateTime @default(now())
}

model KpiRecord {
  id                  String   @id @default(uuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month               String
  baseBonus           Float
  unworkedDays        Int
  sickDays            Int
  lateHours           Float
  deductionPercentage Float
  finalBonus          Float
  attendanceRate      Float
  createdAt           DateTime @default(now())
}

// ── Enterprise KPI Engine Models ───────────────────────────────────────────

model KpiTemplate {
  id           String         @id @default(uuid())
  departmentId String
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  position     String?
  title        String
  criteria     KpiCriterion[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model KpiCriterion {
  id         String      @id @default(uuid())
  templateId String
  template   KpiTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  weight     Float
  target     String
  createdAt  DateTime    @default(now())
}

model KpiEvaluation {
  id           String              @id @default(uuid())
  employeeId   String
  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period       String              // e.g. "2026-08"
  departmentId String
  totalScore   Float               // 0 to 100
  status       String              // EXCELLENT, GOOD, AVERAGE, UNSATISFACTORY
  notes        String?
  scores       KpiCriterionScore[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([employeeId, period])
  @@index([departmentId, period])
}

model KpiCriterionScore {
  id            String        @id @default(uuid())
  evaluationId  String
  evaluation    KpiEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterionName String
  weight        Float
  score         Float         // 0 to 100
}

// ── HR User (RBAC) ──────────────────────────────────────────────────────────

model User {
  id               String                 @id @default(uuid())
  fullName         String
  tabelNumber      String?                @unique
  position         String?                @default("HR Mutaxassis")
  userDepartmentId String?
  userDepartment   Department?            @relation("UserHomeDept", fields: [userDepartmentId], references: [id], onDelete: SetNull)
  username         String                 @unique
  email            String                 @unique
  passwordHash     String
  // Roles: SUPER_ADMIN | EXECUTIVE_DIRECTOR | HR_OFFICER | AUDITOR
  role             String                 @default("HR_OFFICER")
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  departmentAccess UserDepartmentAccess[]
  moduleAccess     UserModuleAccess[]
  auditLogs        AuditLog[]
}

model UserDepartmentAccess {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
}

model SystemModule {
  key          String             @id
  title        String
  iconName     String
  sortOrder    Int                @default(0)
  moduleAccess UserModuleAccess[]
  createdAt    DateTime           @default(now())
}

model UserModuleAccess {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleKey String
  module    SystemModule @relation(fields: [moduleKey], references: [key], onDelete: Cascade)
  canEdit   Boolean      @default(true)

  @@unique([userId, moduleKey])
}

// Legacy HrUser model maintained for database compatibility
model HrUser {
  id                  String     @id @default(uuid())
  username            String     @unique
  passwordHash        String
  fullName            String
  role                String     @default("HR_STAFF")
  assignedDepartments String?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
}

// ── Medical Checkup (HSE) ───────────────────────────────────────────────────

model MedicalCheckup {
  id             String   @id @default(uuid())
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkupDate    DateTime
  expiryDate     DateTime
  // 6 or 12 months
  validityMonths Int      @default(12)
  // O'TGAN | O'TMAGAN | MUDDATI_TUGAGAN
  status         String   @default("O'TGAN")
  clinicName     String?
  orderRef       String?
  notes          String?
  createdAt      DateTime @default(now())

  @@index([employeeId, expiryDate])
}

// ── Safety Briefing (HSE) ───────────────────────────────────────────────────

model SafetyBriefing {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title           String   // e.g. "Elektr Xavfsizligi", "Stanok Boshqarish Yo'riqnomasi"
  completionDate  DateTime
  expiryDate      DateTime
  // Days the briefing stays valid (90 or 365)
  validityDays    Int      @default(365)
  instructorName  String?
  protocolNumber  String?
  notes           String?
  createdAt       DateTime @default(now())
}

// ── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id               String   @id @default(uuid())
  hrUserId         String?
  hrUser           User?    @relation(fields: [hrUserId], references: [id], onDelete: SetNull)
  hrName           String   // Snapshot of name at time of action
  action           String   // e.g. "Xodim ma'lumotlari tahrirlandi"
  targetEmployeeId String?
  fieldChanged     String?
  oldValue         String?
  newValue         String?
  departmentName   String?
  ipAddress        String?
  metadata         String?  // JSON string for extra context
  createdAt        DateTime @default(now())

  @@index([targetEmployeeId, createdAt])
}

// ── Leave Request & 6-Step Approval Workflow ───────────────────────────────

model LeaveRequest {
  id               String              @id @default(uuid())
  employeeId       String
  employee         Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Types: BS_UNPAID, MEHNAT_TATILI, SICK_LEAVE_BL, HOURLY_PERMIT
  type             String
  requestDate      DateTime            @default(now())
  startDate        DateTime
  endDate          DateTime
  totalDays        Int
  reason           String
  // Status: PENDING, APPROVED, REJECTED, CANCELLED
  status           String              @default("PENDING")
  currentStep      Int                 @default(1) // 1 to 6
  rejectionComment  String?
  step3ApproverType String?             @default("TEXNIK_DIREKTOR") // TEXNIK_DIREKTOR or BOSHQARMA_BOSHLIGI
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvalSteps     LeaveApprovalStep[]
}

model LeaveApprovalStep {
  id           String       @id @default(uuid())
  requestId    String
  request      LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepNumber   Int          // 1: Bo'lim Boshlig'i, 2: HR Xodimi, 3: Texnik Direktor, 4: Direktor O'rinbosari, 5: Moliya Direktori, 6: Bosh Direktor
  // Roles: DEPARTMENT_HEAD, HR_OFFICER, TECHNICAL_DIRECTOR, DEPUTY_DIRECTOR, FINANCE_DIRECTOR, GENERAL_DIRECTOR
  approverRole String
  approverName String?
  // Status: PENDING, APPROVED, REJECTED
  status       String       @default("PENDING")
  comment      String?
  actionDate   DateTime?
}


